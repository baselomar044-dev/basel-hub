# ===========================================
# Basel Hub v8.0 - Environment Variables
# ===========================================

# AI Chat (Required) - Get free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxx

# App URL (Optional - auto-detected)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Optional - for cloud sync)
# Get from https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Note: GitHub and Vercel tokens are stored
# securely in the API Keys Wallet inside the app
# ===========================================
